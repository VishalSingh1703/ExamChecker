# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
# Browser origins allowed to open the viva websocket. Comma-separated, or "*"
# for any origin. Keep it tight once this is deployed anywhere public.
VIVA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Voice providers (required) ───────────────────────────────────────────────
# These are the only secrets this service holds. There is deliberately NO
# Gemini key here: grading stays in the browser where it already lives.
SARVAM_API_KEY=
MURF_API_KEY=

# ── Language ─────────────────────────────────────────────────────────────────
VIVA_LANGUAGE=en-IN

# ── Sarvam STT ───────────────────────────────────────────────────────────────
# saarika:v2.5 is what Guardian runs. Its own VAD signals stay off — Silero
# below is the single source of truth for turn detection.
SARVAM_STT_MODEL=saarika:v2.5

# ── Murf TTS ─────────────────────────────────────────────────────────────────
# MURF_VOICE_ID accepts either a bare voice id or a JSON object, e.g.
#   {"voice_id":"en-IN-arohi","style":"Conversational","model":"falcon-2"}
MURF_VOICE_ID=en-IN-arohi
MURF_MODEL=falcon-2
MURF_STYLE=Conversational
MURF_RATE=0
MURF_PITCH=0
MURF_VARIATION=1

# ── Turn detection (Silero VAD) ──────────────────────────────────────────────
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
# Longer than Guardian's 0.2s: a viva answer breathes, and clipping a student
# mid-sentence is unrecoverable in a one-way flow.
VAD_STOP_SECS=0.8

# ── Viva pacing ──────────────────────────────────────────────────────────────
# Quiet time after speech stops before an answer is considered captured.
VIVA_ANSWER_SILENCE_SECS=2.5
# Hard ceiling on one viva session, mirroring Guardian's 360s call cap.
VIVA_MAX_SESSION_SECS=1800
# Matches PRACTICE_MAX_QUESTIONS in the frontend.
VIVA_MAX_QUESTIONS=25

# Set to false to disable uvicorn auto-reload.
RELOAD=true
